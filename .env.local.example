# Next.js (public, an toàn khi lộ ra trình duyệt). Lấy ở Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key hoặc sb_publishable_...>
# Username bot Telegram, không có @ (dùng để tạo link t.me/<bot>?start=<mã>)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Dùng khi server action không đọc được header Origin (vd. deploy sau proxy)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# KHÔNG đặt service role key, bot token hay webhook secret ở đây.
# Những khoá đó chỉ nằm trong Supabase secrets (xem docs/SETUP.md).

# Chỉ cho Supabase local (supabase start) khi bật Google OAuth:
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
